# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Used by server.js for AI teaser reading (get a key at console.anthropic.com)
ANTHROPIC_API_KEY=paste-your-key-here

# Optional, only for a custom domain on Render (comma-separated). Your onrender.com address is allowed automatically.
# ALLOWED_HOSTS=searchdesk.example.com
